        "jsCode": "const b = $json.body; const l = b.lead || {}; const p = b.property || {}; const a = b.agent || {};\n    return { json: { ...b, has_email: !!l.email, subject: `Thanks for viewing ${p.title}`,\n      html: `Hi ${l.name},<br><br>Thank you for visiting <b>${p.title}</b> today. What did you think? If you would like to make an offer, see the paperwork or book a second visit, just reply to this email${a.name ? ' and ' + a.name + ' will take it from there' : ''}.<br><br>Plotwise team` } };",
