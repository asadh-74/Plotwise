{
  "name": "Plotwise 10 - Maintenance triage",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "maintenance-ticket",
        "authentication": "headerAuth",
        "options": {}
      },
      "id": "76d1312e-9008-49c2-b6e9-001de07de0cc",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "0bd09e39-fa69-473a-9ee5-d0fc7ac95e40",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Plotwise API Secret"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body; const t = b.ticket;\n    const prompt = `You triage maintenance requests for rental properties.\nTicket: \"${t.title}\". Details: \"${t.description || ''}\". Property: ${b.property.title}.\nReturn ONLY JSON: {\"category\":\"plumbing|electrical|hvac|carpentry|cleaning|general\",\"urgency\":\"low|medium|high|emergency\",\"summary\":string (max 25 words)}.\nUse emergency only for gas smell, fire, flooding, sparks or a total power loss.`;\n    return { json: { ...b, gemini_body: { contents: [{ role: 'user', parts: [{ text: prompt }] }], generationConfig: { responseMimeType: 'application/json', temperature: 0.1 } } } };",
        "mode": "runOnceForEachItem"
      },
      "id": "6c87a81f-bbda-40f0-ac10-0e2496336a41",
      "name": "Build prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        270,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.gemini_body) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "91e1a1c3-9f62-4bf9-8da1-a8eb24c02fc3",
      "name": "Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Gemini API Key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Build prompt').item.json;\n    let ai = {}; try { ai = JSON.parse($json.candidates[0].content.parts[0].text); } catch (e) { /* fall back below */ }\n    const category = ['plumbing', 'electrical', 'hvac', 'carpentry', 'cleaning', 'general'].includes(ai.category) ? ai.category : 'general';\n    const urgency = ['low', 'medium', 'high', 'emergency'].includes(ai.urgency) ? ai.urgency : 'medium';\n    return { json: { ...prev, triage_body: { category, urgency, ai_summary: ai.summary || prev.ticket.title } } };",
        "mode": "runOnceForEachItem"
      },
      "id": "1c4d968a-2239-43bb-8afa-4fbb15d80bcd",
      "name": "Parse triage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        810,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Parse triage').first().json.api_base + '/api/automation/tickets/' + $('Parse triage').first().json.ticket.id + '/triage' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Parse triage').first().json.triage_body) }}",
        "options": {}
      },
      "id": "1e6ce65f-f1f4-4672-b54c-b6ba65453e93",
      "name": "Save triage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Plotwise API Secret"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const t = $json; const ctx = $('Parse triage').first().json; const v = t.vendor;\n    return { json: { has_vendor: !!(v && v.email), vendor_to: v && v.email, vendor_subject: `[${t.urgency.toUpperCase()}] ${ctx.ticket.title} at ${ctx.property.title}`,\n      vendor_html: `Hi ${v ? v.name : ''},<br><br>New ${t.category} job at <b>${ctx.property.title}</b>${ctx.property.address ? ', ' + ctx.property.address : ''}, ${ctx.property.city}.<br>Problem: ${ctx.ticket.title}. ${ctx.ticket.description || ''}<br>Reported by ${ctx.reporter.name}${ctx.reporter.phone ? ' (' + ctx.reporter.phone + ')' : ''}.<br>Urgency: <b>${t.urgency}</b>.<br><br>Please confirm when you can attend.<br>Plotwise property management`,\n      urgent: ['high', 'emergency'].includes(t.urgency), alert_text: `${t.urgency.toUpperCase()} ${t.category} ticket at ${ctx.property.title}: ${ctx.ticket.title}`, chat_id: (ctx.agent && ctx.agent.telegram_chat_id) || 'REPLACE_WITH_CHAT_ID' } };",
        "mode": "runOnceForEachItem"
      },
      "id": "b010836b-6a4c-4e6e-87bb-693fcb71c643",
      "name": "Build notices",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1350,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "9df7770d-3f09-47c2-8f4e-ada8a459c1c5",
              "leftValue": "={{ $('Build notices').first().json.has_vendor }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "09c9cd12-9484-46c9-bf5a-1f6fd9a8988e",
      "name": "Vendor assigned?",
