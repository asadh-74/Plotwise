      "position": [
        540,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Plotwise API Secret"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const s = $json; const fmt = (v) => 'PKR ' + Number(v).toLocaleString('en-PK');\n    const rows = s.items.map((i) => `<tr><td>${i.property}</td><td align=\"right\">${fmt(i.amount)}</td></tr>`).join('');\n    return { json: { ...s, api_base: $('Config').first().json.api_base, subject: `Your rent statement for ${s.period}`,\n      html: `Hi ${s.landlord_name},<br><br>Here is your rent summary for <b>${s.period}</b>.<br><br><table cellpadding=\"6\" border=\"1\" style=\"border-collapse:collapse\"><tr><th align=\"left\">Property</th><th>Collected</th></tr>${rows}<tr><td><b>Total</b></td><td align=\"right\"><b>${fmt(s.rent_collected)}</b></td></tr></table>${s.tickets ? '<br>Maintenance tickets opened this month: ' + s.tickets + '.' : ''}<br><br>Plotwise property management` } };",
        "mode": "runOnceForEachItem"
      },
      "id": "38a5c060-542a-456f-ae9b-5571fbb5f9e6",
      "name": "Build statement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        810,
        200
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.landlord_email }}",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "205a7ede-e1ad-4466-887f-f1c19bbb8357",
      "name": "Email statement",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1080,
        200
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Build statement').item.json.api_base + '/api/automation/owner-statements' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ landlord_id: $('Build statement').item.json.landlord_id, period: $('Build statement').item.json.period, rent_collected: $('Build statement').item.json.rent_collected, expenses: 0 }) }}",
        "options": {}
      },
      "id": "addc22cd-13fd-45a0-8538-4af348d81cec",
