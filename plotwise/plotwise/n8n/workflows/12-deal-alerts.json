{
  "name": "Plotwise 12 - Deal alerts",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "deal-alert",
        "authentication": "headerAuth",
        "options": {}
      },
      "id": "3c36cd00-a773-4e0c-b22c-f784936c52e5",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "44136deb-fefc-494a-9280-28b838fa5a47",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Plotwise API Secret"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body; const l = b.listing; const f2 = (v) => 'PKR ' + Number(v).toLocaleString('en-PK');\n    const text = `New deal for \"${b.search_name}\": ${l.title}, ${l.city}. Asking ${f2(l.price)}, ${l.price_gap_pct}% below the estimated fair price of ${f2(l.estimated_price)}.`;\n    return { json: { ...b, text, subject: `Deal alert: ${l.title} is ${l.price_gap_pct}% below fair price`, html: `Hi ${b.user.name},<br><br>${text}<br><br>Log in to Plotwise to see it in the deal finder.`, use_telegram: b.channel === 'telegram' && !!b.user.telegram_chat_id } };",
        "mode": "runOnceForEachItem"
      },
      "id": "2c044d39-af38-4be5-a865-4169dfd74e7f",
      "name": "Build alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        270,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "fe637912-b0f1-4f05-b184-6294378bae5c",
              "leftValue": "={{ $json.use_telegram }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "775ce50d-72e3-4a10-a9b3-03fc0eb9687d",
      "name": "Send by Telegram?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        540,
        200
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.user.telegram_chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "c707263f-9a00-4e74-a5bc-b6b18796def6",
      "name": "Telegram alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        810,
        200
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram bot"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.user.email }}",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "1ff0c4a7-a4c8-4122-8a41-04e66e61cd82",
      "name": "Email alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        810,
        390
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Build alert').first().json.api_base + '/api/automation/alerts/' + $('Build alert').first().json.alert_id + '/sent' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {}
      },
      "id": "69c1f687-dbd0-471e-9acb-6f102554aac2",
      "name": "Mark alert sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Plotwise API Secret"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Build alert').first().json.api_base + '/api/automation/runs/' + $('Build alert').first().json.run_id + '/finish' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'success' }) }}",
        "options": {}
      },
      "id": "bf18a34f-004d-428e-91b3-8e60a9934fb6",
      "name": "Finish run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1350,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Plotwise API Secret"
        }
      }
    }
  ],
