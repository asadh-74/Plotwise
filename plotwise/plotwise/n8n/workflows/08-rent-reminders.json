      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Build reminder').item.json.landlord_to }}",
        "subject": "={{ $('Build reminder').item.json.landlord_subject }}",
        "message": "={{ $('Build reminder').item.json.landlord_html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "e0a52e95-c919-4435-99c1-5e75e3c4913b",
      "name": "Notify landlord",
