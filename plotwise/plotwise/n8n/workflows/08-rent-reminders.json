      "name": "Log run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Plotwise API Secret"
        }
      }
    }
