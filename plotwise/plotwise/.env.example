# Local demo configuration
# These values are for the included Docker Compose MySQL instance only.
DATABASE_URL=mysql://root:root@127.0.0.1:3306/plotwise

# Replace these values before sharing a local instance.
JWT_SECRET=replace-with-a-long-random-local-secret
AUTOMATION_SECRET=replace-with-a-different-long-random-local-secret

# Leave blank to use local fallback automations. Configure n8n before setting this.
N8N_WEBHOOK_BASE=
APP_BASE_URL=http://localhost:3000

# Creates fictional sample records on first startup. Set to false for an empty database.
DEMO_SEED=true
APP_TZ_OFFSET=+05:00

# Optional for managed MySQL using a CA certificate.
DB_CA_PATH=
# Or provide the certificate contents with newlines represented as \n.
DB_CA_PEM=
